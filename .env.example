# Runtime mode: mock or live
ISSUE_RCA_MODE=mock

# DeepSeek (OpenAI-compatible API)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# GitHub REST API
GITHUB_TOKEN=
GITHUB_API_VERSION=2026-03-10

# Composio Sessions + GitHub connected account
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=issue-rca-local
COMPOSIO_GITHUB_CONNECTED_ACCOUNT_ID=

# Runtime limits
LOG_LEVEL=INFO
RUNS_DIR=artifacts/runs
MAX_CANDIDATE_FILES=10
MAX_AGENT_OUTPUT_TOKENS=1200
DEEPSEEK_SYNTHESIS_MAX_TOKENS=1800
REQUEST_TIMEOUT_SECONDS=30
LOCAL_REPO_PATH=
